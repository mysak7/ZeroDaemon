# Copy to .env and fill in your keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
MCP_API_KEY=...        # API key for the MCP server (seip-mcp)

# Vertex proxy (LiteLLM at vertex.mysak.fun, behind Cloudflare Access)
# VERTEX_API_KEY is the LiteLLM master key; the CF_ACCESS_* pair is the
# Cloudflare Access service token (terraform output from dns-mysak-cloudflare).
VERTEX_API_KEY=MYSAK_...
VERTEX_CF_ACCESS_CLIENT_ID=...
VERTEX_CF_ACCESS_CLIENT_SECRET=...

# Optional overrides
# ZERODAEMON_DB_PATH=zerodaemon.db
# ZERODAEMON_OLLAMA_BASE_URL=http://localhost:11434
# ZERODAEMON_VERTEX_BASE_URL=https://vertex.mysak.fun/v1

# Security — API key required for all non-health routes (leave empty to disable)
# ZERODAEMON_API_KEY=change-me-in-production

# CORS — JSON array of allowed origins (default: ["*"] for local dev)
# ZERODAEMON_ALLOWED_ORIGINS=["https://your-domain.com"]
